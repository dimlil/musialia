<form id="createForm" action="/create" method="POST">
    <h2>Създаване</h2>
    <div class="inputes-wrapper">
        <div class="input-wrapper">
            <label for="name">Име: </label>
            <input type="text" id="name" name="name">
        </div>
        <div class="input-wrapper">
            <label for="imageUrl">Снимка: </label>
            <input type="text" id="imageUrl" name="imageUrl">
        </div>
        <div class="input-wrapper">
            <label for="mainfacturer">Производител: </label>
            <input type="text" id="mainfacturer" name="mainfacturer">
        </div>
        <div class="input-wrapper">
            <label for="description">Описание: </label>
            <input type="text" id="description" name="description">
        </div>
        <div class="input-wrapper">
            <label for="type">Тип: </label>
            <input type="text" id="type" name="type">
        </div>
        <div class="input-wrapper">
            <label for="price">Цена: </label>
            <input type="text" id="price" name="price">
        </div>
        <div class="input-wrapper">
            <label for="quantity">Брой в склада: </label>
            <input type="text" id="quantity" name="quantity">
        </div>
        <button type="submit">Създаване</button>
    </div>
</form>