<div class="postWrapper">
    {{#if items}}
    <div class="box">
        <img src="{{items.imageUrl}}" alt="product image">
        <div>
            <h3>{{items.name}}</h3>
            <p>Цена: {{items.price}} лв.</p>
            <p>Производител: {{items.mainfacturer}}</p>
            <p>Тип: {{items.type}}</p>
            <p>Описание: {{items.description}}</p>
            <div class="buttonsWrapper">
                {{#if isAdmin}}
                <a href="/updateItem/{{items._id}}">Промени</a>
                <a href="/deleteItem/{{items._id}}">Изтрий</a>
                {{else}}
                {{/if}}
                <a href="/addToCart/{{items._id}}">Купи</a>
            </div>
            {{/if}}
        </div>
    </div>
</div>