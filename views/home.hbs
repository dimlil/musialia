<div class="lastItems">
    <h2>
        Добре дошли в Musialia - музикалният рай!
    </h2>
    <h3>
        Последно добавени:
    </h3>
    <div class="allPostsWrapper">
        {{#if items}}
            {{#each items}}
            <div class="box">
                <h3>{{this.name}}</h3>
                <img src="{{this.imageUrl}}" alt="product image">
                <p>{{this.price}} лв.</p>
                <a href="/product/{{this._id}}">Повече</a>
            </div>
            {{/each}}
            {{else}}
            <p>Нямате добавени продукти</p>
        {{/if }}
    </div>
    <p>Вижте нашите <a href="/products">продукти</a></p>
</div>